---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout>
  <section class="shell hero">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="status-dot"></span> WELCOME TO MY DIGITAL SPACE</p>
      <h1 class="display-title" aria-label="Code. Create. Share.">
        <span>CODE.</span>
        <span class="outline">CREATE.</span>
        <span class="accent">SHARE.</span>
      </h1>
      <p class="hero-intro">
        你好，我是 <strong>{site.name}</strong>，一名来自{site.location}的{site.role}。<br />
        我正在 <span class="typed" data-typewriter aria-hidden="true" data-words='["把后端写扎实", "把 AI 接进真实业务", "把踩过的坑记成文章"]'></span><span class="caret" aria-hidden="true">_</span>
        <span class="sr-only">我正在把后端写扎实、把 AI 接进真实业务，并把踩过的坑记成文章。</span>
      </p>
      <div class="button-row">
        <a class="button button-primary" data-magnetic href="/projects">看看我的项目<Icon name="arrow-up-right" /></a>
        <a class="button" data-magnetic href="/blog">读点文章<Icon name="arrow-right" /></a>
      </div>
      <div class="hero-footnote">
        <span>BASED IN {site.location.toUpperCase()}</span>
        <span>SCROLL TO EXPLORE</span>
      </div>
      <a class="scroll-cue" href="#projects" data-magnetic data-cursor="SCROLL"><span></span>SCROLL TO WORK</a>
    </div>
    <div class="hero-panel interactive-card" data-cursor-card data-cursor-label="SYSTEM ONLINE" data-reveal>
      <div class="panel-topline"><span>PERSONAL.SYSTEM</span><span>v2.0.0</span></div>
      <div class="hero-orbit" aria-hidden="true">
        <span class="orbit-ring"></span>
        <span class="orbit-axis"></span>
        <span class="orbit-axis vertical"></span>
        <span class="orbit-node node-one"></span>
        <span class="orbit-node node-two"></span>
        <span class="orbit-core">{site.name.slice(0, 1).toUpperCase()}</span>
      </div>
      <div class="panel-code" aria-hidden="true">
        <span>const curiosity = Infinity;</span>
        <span>while (alive) {'{ keepLearning(); }'}</span>
      </div>
      <div class="panel-bottom"><span>STATUS / <strong>BUILDING</strong></span><span>{String(projects.length).padStart(2, '0')} PROJECTS</span></div>
    </div>
  </section>

  <div class="tech-rail">
    <div class="shell">
      <span class="tech-label">TOOLS I EXPLORE</span>
      <ul class="tech-list">{site.stack.map((tech) => <li>{tech}</li>)}</ul>
    </div>
  </div>

  <section class="shell section" id="projects">
    <SectionHeading eyebrow="01 / SELECTED WORK" title="把想法变成作品" href="/projects" linkLabel="全部项目" />
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    ) : <div class="empty-state">项目正在打磨中，敬请期待。</div>}
  </section>

  <section class="shell section" id="writing">
    <SectionHeading eyebrow="02 / LATEST WRITING" title="记录学习，也记录思考" href="/blog" linkLabel="全部文章" />
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.slice(0, 3).map((post, index) => <PostRow post={post} index={index} />)}
      </div>
    ) : <div class="empty-state">第一篇文章正在路上。</div>}
  </section>

  <section class="shell section">
    <div class="about-teaser">
      <div class="about-copy" data-reveal>
        <p class="eyebrow">03 / ABOUT ME</p>
        <h2 class="about-statement">保持好奇，动手验证，<br />然后<span>毫无保留地分享。</span></h2>
        <p>我关注 Web、AI 与开发者工具，喜欢把复杂的问题拆小，再把解决问题的过程写清楚。这个网站是我的作品架，也是我的学习日志。</p>
        <a class="text-link" href="/about">更多关于我<Icon name="arrow-right" /></a>
      </div>
      <div class="now-card interactive-card" data-cursor-card data-cursor-label="NOW" data-reveal>
        <div class="now-card-header"><span>CURRENTLY / NOW</span><span class="status-dot"></span></div>
        <ul class="now-list">
          <li><span>01</span><div><strong>探索 AI 应用</strong><p>从大模型能力到真正好用的产品。</p></div></li>
          <li><span>02</span><div><strong>打磨 Web 基础</strong><p>关注性能、可访问性与交互细节。</p></div></li>
          <li><span>03</span><div><strong>坚持公开学习</strong><p>把输入变成输出，把输出变成连接。</p></div></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
