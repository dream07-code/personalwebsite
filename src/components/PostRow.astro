---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/format';
import Icon from './Icon.astro';
interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
}
const { post, index } = Astro.props;
---
<article class="post-row interactive-card" data-cursor-card data-cursor-label="READ POST" data-reveal>
  <a href={`/blog/${post.id}`}>
    <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
    <div class="post-main">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body ?? '')} MIN READ</span>
      </div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <ul class="tag-list" aria-label="文章标签">
        {post.data.tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    </div>
    <span class="post-arrow"><Icon name="arrow-up-right" size={22} /></span>
  </a>
</article>
