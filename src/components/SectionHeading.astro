---
import Icon from './Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, href, linkLabel = '查看全部' } = Astro.props;
---
<div class="section-heading" data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && <a class="text-link" href={href}>{linkLabel}<Icon name="arrow-right" /></a>}
</div>
